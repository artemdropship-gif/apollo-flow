# ---- Database (PostgreSQL, e.g. Neon) ----
# Pooled connection string. Create a free project at https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Better Auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="changeme"
# Base URL of the app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Project Vault encryption ----
# 32-byte hex key used for AES-256-GCM encryption of stored secrets.
# Generate with: openssl rand -hex 32
VAULT_ENCRYPTION_KEY="changeme-64-hex-chars"

# ---- AI via Anthropic-compatible gateway (Claude) ----
# Anthropic-compatible endpoint (same setup as the OpenClaw config).
# Leave the token empty to use the built-in heuristic fallback (no external calls).
ANTHROPIC_BASE_URL="https://aiprimetech.io"
ANTHROPIC_AUTH_TOKEN=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- Maps / business search (optional) ----
# OpenStreetMap (Overpass/Nominatim) is used by default and needs NO key.
# Add keys below to enable extra providers later.
GOOGLE_MAPS_API_KEY=""
YANDEX_MAPS_API_KEY=""
TWOGIS_API_KEY=""
